# ==============================================================================
# Birthday Memory Site — Environment Configuration
# ==============================================================================

# Server Setup
PORT=3000
NODE_ENV=development

# Security Secrets (change these to secure strings in production)
JWT_SECRET=super_secret_romantic_jwt_key_change_me_in_production
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Initial Login Credentials (used to seed login accounts)
ADMIN_USERNAME=love
ADMIN_PASSWORD=password123
VIEWER_USERNAME=rubina
VIEWER_PASSWORD=love123

# Personal Details (Editable here or in server/data/personalConfig.json)
PARTNER_NAME=My Love
YOUR_NAME=Me
RELATIONSHIP_START_DATE=2026-03-21T00:00:00

# Partner's Birthday Date (Month: 1-12, Day: 1-31)
# Unlocks special birthday letter & confetti celebration on this day!
PARTNER_BIRTHDAY_MONTH=9
PARTNER_BIRTHDAY_DAY=21

# Birthday Letter / Special Note
BIRTHDAY_NOTE="Happy Birthday to the most incredible person in my life. Every day with you is filled with warmth, laughter, and so much love. Here's to celebrating you today and every single day!"

# Optional: Spotify Integration (Get credentials from https://developer.spotify.com/dashboard)
# If left empty, search and manual Spotify track links / fallback embed players still work smoothly!
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback

# Optional: MongoDB Connection URI (Leave empty to use zero-config local JSON file storage)
# Example: mongodb://localhost:27017/birthday_site
MONGODB_URI=

# Optional: Cloudinary for cloud photo storage (Leave empty to use local /uploads folder storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
